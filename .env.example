# Documentation only: Spring Boot does not load .env automatically.
# Set these variables in the terminal/IDE that starts the app. Never commit real values.
DB_URL=jdbc:mysql://localhost:3306/travel_db
DB_USERNAME=
DB_PASSWORD=
# Use the decoded data.go.kr service key; the app URL-encodes it once.
PUBLIC_DATA_SERVICE_KEY=
# Public browser key: allow only your actual site domains in Kakao Developers.
KAKAO_MAP_JAVASCRIPT_KEY=
UPLOAD_DIR=./uploads/
